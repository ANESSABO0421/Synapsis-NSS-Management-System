# --- Required ---
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/synapsis
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server ---
PORT=3000
NODE_ENV=development
# Optional comma-separated list overriding the default allowed origins
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Cloudinary (uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (OTP) ---
EMAIL_USER=
EMAIL_PASS=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (donations) ---
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/donations/webhook` or the dashboard
STRIPE_WEBHOOK_SECRET=

# --- AI ---
GROQ_API_KEY=
HUGGINGFACE_TOKEN=
